# Copy this file to .env and set your own values. Never commit .env.

# Password of the PostgreSQL user "zai" (applied only when the database volume is first created)
POSTGRES_PASSWORD='change-me-db'

# Administrator account created on the first start (when no administrator exists yet)
# Put values with special characters in single quotes, e.g. ADMIN_PASSWORD='a$b#c'.
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='My$ecret#Pass123'

# Server only: start Caddy with HTTPS for this domain
# COMPOSE_PROFILES=production
# DOMAIN=203-0-113-10.sslip.io