# Manual tests of the administrator account: login, logout and password change.
# Pick the environment in the "env" list above the editor.
# Variables come from http-client.env.json and http-client.env.json.user.

### Login with an empty object: 400, both fields listed
POST {{host}}/api/auth/login
Content-Type: application/json

{}

### Login with wrong field types: 400
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": 1, "password": true }

### Login with invalid JSON: 400
POST {{host}}/api/auth/login
Content-Type: application/json

{nope

### Login with a wrong Content-Type: 415
POST {{host}}/api/auth/login
Content-Type: text/plain

{ "username": "admin", "password": "x" }

### Login with a wrong password: 401
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{admin}}", "password": "wrong-password" }

### Login with an unknown user: 401 (same message as a wrong password)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "nobody", "password": "wrong-password" }

### Login with correct data: 200 with accessToken, tokenType "Bearer", expiresIn 28800
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{admin}}", "password": "{{password}}" }

###
@token = {{login.response.body.$.accessToken}}

### Logout without a token: 401 with WWW-Authenticate: Bearer
POST {{host}}/api/auth/logout

### Logout with an unknown token: 401
POST {{host}}/api/auth/logout
Authorization: Bearer not-a-real-token

### Logout with a wrong scheme: 401
POST {{host}}/api/auth/logout
Authorization: Basic YWRtaW46eA==

### Logout with the token from the login request: 204 (send the login request first)
POST {{host}}/api/auth/logout
Authorization: Bearer {{token}}

### Logout again with the same token: 401 (the session no longer exists)
POST {{host}}/api/auth/logout
Authorization: Bearer {{token}}


### ---- Password change tests: ----

### Login for the password tests: 200
# @name passwordLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{admin}}", "password": "{{password}}" }

###
@passwordToken = {{passwordLogin.response.body.$.accessToken}}

### Change the password without a token: 401
PUT {{host}}/api/auth/password
Content-Type: application/json

{ "currentPassword": "x", "newPassword": "long-enough-password" }

### Change the password with an empty object: 400, both fields listed
PUT {{host}}/api/auth/password
Authorization: Bearer {{passwordToken}}
Content-Type: application/json

{}

### Change the password with a too short new password: 422
PUT {{host}}/api/auth/password
Authorization: Bearer {{passwordToken}}
Content-Type: application/json

{ "currentPassword": "{{password}}", "newPassword": "short" }

### Change the password with a wrong current password: 403
PUT {{host}}/api/auth/password
Authorization: Bearer {{passwordToken}}
Content-Type: application/json

{ "currentPassword": "wrong-password", "newPassword": "long-enough-password" }

### Second login, a separate session: 200
# @name otherLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "{{admin}}", "password": "{{password}}" }

###
@otherToken = {{otherLogin.response.body.$.accessToken}}

### Change the password to a temporary one: 204 (the session of this token stays valid)
PUT {{host}}/api/auth/password
Authorization: Bearer {{passwordToken}}
Content-Type: application/json

{ "currentPassword": "{{password}}", "newPassword": "temporary-password-1" }

### The other session was removed by the password change: 401
POST {{host}}/api/auth/logout
Authorization: Bearer {{otherToken}}

### Restore the original password with the same token: 204
PUT {{host}}/api/auth/password
Authorization: Bearer {{passwordToken}}
Content-Type: application/json

{ "currentPassword": "temporary-password-1", "newPassword": "{{password}}" }
